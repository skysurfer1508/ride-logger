SESSION_SECRET=changeme-long-random-secret
DB_PATH=./data/ride_logger.db

# Authentik OIDC login. Any authenticated Authentik user can log in here --
# this app is open to everyone, not admin-only. Client ID isn't secret; get
# the Client Secret from the Authentik UI (Providers -> ride-logger-provider
# -> reveal Client Secret) and paste it here directly on the server.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=https://auth.skyserver1508.org/application/o/ride-logger/.well-known/openid-configuration
OIDC_REDIRECT_URI=https://ride.skyserver1508.org/auth/callback

# Ride segmentation tuning (optional, these are the defaults)
GAP_MINUTES=10
MIN_POINTS=5
MIN_DISTANCE_M=200
STALE_TRIP_MINUTES=60

# There is no shared ingest token anymore -- each user gets their own,
# auto-created and shown on their own /settings page after logging in.

# Matching a ride's stops to traffic lights and signs (OpenStreetMap via the public Overpass API, cached in the database).
# OSM_ENABLED=true
# OSM_USER_AGENT=ride-logger/1.0 (you@example.com)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Traffic tab (both optional, both free). Apple's traffic colours need no key.
# Official Swiss traffic situations: register at https://api-manager.opentransportdata.swiss and subscribe to "Traffic situations".
# OPENTRANSPORTDATA_API_KEY=
# Public webcams near a spot: https://api.windy.com/keys
# WINDY_API_KEY=

# The natural navigation voice (Piper, local; set up with `sh deploy/voice/setup.sh`). Without it the app speaks with the phone's own voice.
# VOICE_ENABLED=true
# VOICE_EN_MODEL=en_US-ryan-high
# VOICE_DE_MODEL=de_DE-thorsten-medium
